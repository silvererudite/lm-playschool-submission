# Upstream repos (cloned by setup.sh, not tracked here)
playpen/
clembench/

# Secrets — never commit. key.json holds HF/OpenAI/etc API keys.
key.json
*.key
*.pem
.env
.env.*

# Local-only Claude Code working directory (history, sessions, plans, tasks)
.claude/

# Caches and runtime artifacts
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model checkpoints + eval outputs (live on NVMe via symlinks)
models
models/
playpen-eval
playpen-eval/
dist
dist/
*.bin
*.safetensors
*.pt
*.ckpt

# results/ is tracked (small CSVs and val.jsons), but exclude any large
# byproducts that might accidentally land there
results/**/*.html
results/**/transcripts/

# Data caches
hf-cache/
datasets-cache/

# Logs (kept on disk, not in git)
logs/
*.log

# Editor / OS junk
.DS_Store
.idea/
.vscode/
*.swp
